{
  "name": "codemarkets-jobs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-packs.mjs",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "dev": "npm run build && node --env-file=.env ./node_modules/.bin/wrangler dev",
    "migrate": "node --env-file=.env ./node_modules/.bin/wrangler d1 migrations apply codemarkets-jobs --remote",
    "deploy": "npm run build && npm run check && node --env-file=.env ./node_modules/.bin/wrangler deploy",
    "master": "node --env-file=.env scripts/create-master.mjs",
    "admin": "node --env-file=.env scripts/admin.mjs"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.138.0"
  }
}
